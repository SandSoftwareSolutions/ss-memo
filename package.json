{
  "name": "@sandsoftwaresolutions/memo",
  "version": "0.1.1",
  "description": "A TTL cache with single-flight loading, stale-while-revalidate and a memory cap; memoize for functions.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "cache",
    "memoize",
    "ttl",
    "single-flight"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-memo.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-memo/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-memo#readme",
  "publishConfig": {
    "access": "public"
  }
}
